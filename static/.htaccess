ErrorDocument 404 /404.html

# ── Paritat d'URLs WordPress → Hugo ──────────────────────────────────────────
# El WP (2010-2026) servia: tags a /tag/<slug>/ (flat) i categories a
# /category/<pare>/<fill>/ (jeràrquic; pares: camara, optioca, publicacions).
# Hugo genera /tag/<slug>/ i /category/<fill>/ (aplanat) + índexs a /tags/ i
# /categories/, i el feed a /feed.xml. Aquestes regles mantenen la paritat:
#   1) /feed/ del WP → serveix /feed.xml directament (subscriptors existents)
#   2) categories jeràrquiques del WP → aplanades amb 301
#   3) plurals provisionals dels primers dies de Hugo (set 2026) → singular
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── HTTP → HTTPS ──────────────────────────────────────────────────────────
  # El proxy frontal (Varnish) envia el protocol original del client a Apache
  # via X-Forwarded-Proto ("http" o "https"). Apache rep HTTP internament, així
  # que %{HTTPS} no és fiable aquí. Es redirigeix quan el client ha vingut per
  # HTTP en clar. Cache-Control: no-store (via E=NO_CACHE) evita que Varnish
  # guardi el 301 i el serveixi a clients HTTPS → bucle infinit.
  # (Verificat 2026-09-17: el proxy SÍ envia X-Forwarded-Proto.)
  RewriteCond %{HTTP:X-Forwarded-Proto} ^http$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,E=NO_CACHE:1]

  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store" env=NO_CACHE
  </IfModule>

  # Feed del WP: servir el RSS a /feed/ sense redirect (compatibilitat subscriptors)
  RewriteRule ^feed/?$ /feed.xml [L]
  # Feed de comentaris del WP → feed principal
  RewriteRule ^comments/feed/?$ /feed.xml [R=301,L]

  # Cas especial: horsman-8x10″ (nicename WP amb ″ U+2033) → Hugo l'aplana.
  # NOTA: mod_rewrite en context .htaccess contrasta el path DESCODIFICAT
  # (caràcter ″ literal), no el percent-encoded — per això el patró porta el ″.
  RewriteRule ^category/camara/horsman-8x10″/?$ /category/horsman-8x10/ [R=301,L]

  # Categories jeràrquiques del WP → aplanades (301)
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/?$ /category/$2/ [R=301,L]
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/page/([0-9]+)/?$ /category/$2/page/$3/ [R=301,L]
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/feed/?$ /category/$2/ [R=301,L]

  # El pare "publicacions" no existeix com a terme a Hugo → índex de categories
  RewriteRule ^category/publicacions/?$ /categories/ [R=301,L]

  # Plurals provisionals (Hugo, set 2026) → singular (paritat WP)
  RewriteRule ^tags/(.+)$ /tag/$1 [R=301,L]
  RewriteRule ^categories/(.+)$ /category/$1 [R=301,L]
</IfModule>



# ── Headers de seguretat ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS: només quan la connexió ja és HTTPS (evita contingut sense xifrar)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # Evita sniffing del tipus MIME
  Header always set X-Content-Type-Options "nosniff"
  # No enquadra el lloc en iframes d'altres dominis
  Header always set X-Frame-Options "DENY"
  # Referrer mínim a tercers
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # CSP: 'unsafe-inline' a script/style perquè el JSON-LD i els scripts
  # d'Hugo són inline sense nonce (site estàtic, sense build per petició).
  # 'wasm-unsafe-eval' + worker-src: Pagefind (cerca) usa WebAssembly + worker.
  # img-src ample: 15 anys de posts amb imatges hotlinkejades a wordpress.com,
  # ggpht.com, wikimedia, etc. a més de lh*.googleusercontent.com (Google Fotos).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://gc.zgo.at https://giscus.app; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://*.goatcounter.com; frame-src https://player.vimeo.com https://giscus.app; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # Cap ús de càmera/micro/geolocalització/pagaments al lloc
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
</IfModule>