ErrorDocument 404 /404.html

# ── Tipus MIME: els .webp es servien sense Content-Type (els .jpg sí) ───────
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ── Paritat d'URLs WordPress → Hugo ──────────────────────────────────────────
# El WP (2010-2026) servia: tags a /tag/<slug>/ (flat) i categories a
# /category/<pare>/<fill>/ (jeràrquic; pares: camara, optioca, publicacions).
# Hugo genera /tag/<slug>/ i /category/<fill>/ (aplanat) + índexs a /tags/ i
# /categories/, i el feed a /feed.xml. Aquestes regles mantenen la paritat:
#   1) /feed/ del WP → serveix /feed.xml directament (subscriptors existents)
#   2) categories jeràrquiques del WP → aplanades amb 301
#   3) plurals provisionals dels primers dies de Hugo (set 2026) → singular
#
# IMPORTANT: tots els [R=301] fan servir https://%{HTTP_HOST} absolut. Apache,
# darrere el proxy (Varnish) de Dinahosting, rep HTTP intern; amb una
# substitució relativa generaria Location: http:// i forçaria un salt extra
# HTTPS → HTTP → HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── HTTP → HTTPS ──────────────────────────────────────────────────────────
  # El proxy frontal (Varnish) envia el protocol original del client a Apache
  # via X-Forwarded-Proto ("http" o "https"). Apache rep HTTP internament, així
  # que %{HTTPS} no és fiable aquí. Es redirigeix quan el client ha vingut per
  # HTTP en clar. Cache-Control: no-store (via E=NO_CACHE) evita que Varnish
  # guardi el 301 i el serveixi a clients HTTPS → bucle infinit.
  RewriteCond %{HTTP:X-Forwarded-Proto} ^http$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,E=NO_CACHE:1]

  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store" env=NO_CACHE
  </IfModule>

  # Feed del WP: servir el RSS a /feed/ sense redirect (compatibilitat subscriptors)
  RewriteRule ^feed/?$ /feed.xml [L]

  # Feed de comentaris del WP → feed principal
  RewriteRule ^comments/feed/?$ https://%{HTTP_HOST}/feed.xml [R=301,L]

  # Cas especial: horsman-8x10″ (nicename WP amb ″ U+2033) → Hugo l'aplana.
  RewriteRule ^category/camara/horsman-8x10″/?$ https://%{HTTP_HOST}/category/horsman-8x10/ [R=301,L]

  # Hub de taxonomies: les pàgines de paginació que genera Hugo
  # (/tags/page/N/, /categories/page/N/) duplicaven el hub → 301 al hub.
  RewriteRule ^tags/page/[0-9]+/?$ https://%{HTTP_HOST}/tags/ [R=301,L]
  RewriteRule ^categories/page/[0-9]+/?$ https://%{HTTP_HOST}/categories/ [R=301,L]

  # Categories jeràrquiques del WP → aplanades (301)
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/?$ https://%{HTTP_HOST}/category/$2/ [R=301,L]
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/page/([0-9]+)/?$ https://%{HTTP_HOST}/category/$2/page/$3/ [R=301,L]
  RewriteRule ^category/(camara|optioca|publicacions)/([^/]+)/feed/?$ https://%{HTTP_HOST}/category/$2/ [R=301,L]

  # El pare "publicacions" no existeix com a terme a Hugo → índex de categories
  RewriteRule ^category/publicacions/?$ https://%{HTTP_HOST}/categories/ [R=301,L]

  # Plurals provisionals (Hugo, set 2026) → singular (paritat WP)
  RewriteRule ^tags/(.+)$ https://%{HTTP_HOST}/tag/$1 [R=301,L]
  RewriteRule ^categories/(.+)$ https://%{HTTP_HOST}/category/$1 [R=301,L]

  # Feeds de posts individuals del WP (/YYYY/MM/DD/slug/feed/) → post
  RewriteRule ^([0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+)/feed([.]xml)?/?$ https://%{HTTP_HOST}/$1/ [R=301,L]
  RewriteRule ^([0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+)/comments/feed/?$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # Categories pare del WP (camara/optioca no existeixen a Hugo aplanada) → índex
  RewriteRule ^category/(camara|optioca)/?$ https://%{HTTP_HOST}/categories/ [R=301,L]
  RewriteRule ^category/(camara|optioca)/feed[.]xml$ https://%{HTTP_HOST}/feed.xml [R=301,L]

  # Arxius d'autor del WP (no existeixen a Hugo) → home
  RewriteRule ^author/.*$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# ── Feeds RSS: no indexar (NOMÉS feed.xml; MAI sitemap.xml) ──────────────────
<IfModule mod_headers.c>
  <FilesMatch "feed[.]xml$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# ── Headers de seguretat ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS: només quan la connexió ja és HTTPS (evita contingut sense xifrar)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  # Evita sniffing del tipus MIME
  Header always set X-Content-Type-Options "nosniff"
  # No enquadra el lloc en iframes d'altres dominis
  Header always set X-Frame-Options "DENY"
  # Referrer mínim a tercers
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Aïllament de finestra i recursos (XS-Leaks / incrustació)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  # CSP: 'unsafe-inline' a script/style perquè el JSON-LD i els scripts
  # d'Hugo són inline sense nonce (site estàtic, sense build per petició).
  # 'wasm-unsafe-eval' + worker-src: Pagefind (cerca) usa WebAssembly + worker.
  # img-src ample: 15 anys de posts amb imatges hotlinkejades a wordpress.com,
  # ggpht.com, wikimedia, etc. a més de lh*.googleusercontent.com (Google Fotos).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://gc.zgo.at https://giscus.app; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://*.goatcounter.com; frame-src https://player.vimeo.com https://giscus.app; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # Cap ús de càmera/micro/geolocalització/pagaments al lloc
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
</IfModule>
