# CSP propi per a /stats/: el dashboard usa scripts inline i onclick.
# Així el CSP global pot prescindir de 'unsafe-inline' a script-src.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://*.goatcounter.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
</IfModule>
